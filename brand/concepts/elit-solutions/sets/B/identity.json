  "rationale": [
    {
      "claim": "Tektur's capital I has slab serifs, so ElIT stays legible: the l is a plain stem, the I is serifed.",
      "evidence": "measured",
      "source": "type specimen render"
    },
    {
      "claim": "An umbrella brand needs a container: product marks reuse the brackets with their own core colour, so every product is visibly ElIT-built without sharing a name.",
      "evidence": "judgement"
    },
    {
      "claim": "Concrete grey plus graphite keeps the ground neutral; ember is the only hue (a single-accent structure).",
      "evidence": "judgement"
    }
  ],
